# Demo mode: bypass Anthropic + Postgres with canned responses.
# Perfect for trying the UI without credentials. Switch to false once you have keys.
DEMO_MODE=true

# Only used when DEMO_MODE=false:
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql+asyncpg://readonly_user:password@host:5432/dbname

PIPELINE_MAX_SQL_RETRIES=2
PIPELINE_QUERY_TIMEOUT_SECONDS=15
PIPELINE_MAX_RESULT_ROWS=1000
PIPELINE_SCHEMA_CACHE_TTL_SECONDS=300

API_RATE_LIMIT=20/minute

LOG_LEVEL=INFO
